{{define "catalog"}}<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Catalog — AgentHub</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body class="min-h-full bg-slate-950 text-slate-100 antialiased">
  <main class="mx-auto max-w-6xl px-6 py-12">
    <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-sky-400">AgentHub</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Catalog</h1>
        <p class="mt-2 max-w-2xl text-slate-300">Browse published agents, skills, tools, prompts and packs.</p>
      </div>
      <a href="/" class="text-sm text-slate-400 hover:text-sky-300">← Home</a>
    </header>

    <form method="get" action="/assets" class="mb-8 flex flex-wrap gap-3">
      <input type="search" name="q" value="{{.Query}}" placeholder="Search assets…"
        class="flex-1 min-w-[200px] rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:border-sky-500 focus:outline-none">
      <select name="kind" class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100">
        <option value="">All kinds</option>
        {{range .Kinds}}
        <option value="{{.}}" {{if eq $.KindFilter .}}selected{{end}}>{{.}}</option>
        {{end}}
      </select>
      <button type="submit" class="rounded-lg bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-500">Search</button>
    </form>

    {{if .Assets}}
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {{range .Assets}}
      <article class="flex flex-col rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <div class="flex items-start gap-3">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-2xl">
            {{if .IconDigest}}<img src="/icon/{{.IconDigest}}" alt="" class="h-12 w-12 rounded-lg object-cover">{{else}}{{kindIcon .Kind}}{{end}}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <h2 class="truncate text-lg font-semibold">
                <a href="/a/{{.Namespace}}/{{kindSlug .Kind}}/{{.Name}}" class="hover:text-sky-300">{{or .DisplayName .Name}}</a>
              </h2>
            </div>
            <p class="text-xs uppercase tracking-widest text-slate-500">{{kindSlug .Kind}} · {{.Namespace}}</p>
          </div>
        </div>
        {{if .Summary}}<p class="mt-3 text-sm text-slate-300">{{.Summary}}</p>{{else}}<p class="mt-3 text-sm italic text-slate-500">No description.</p>{{end}}
        {{if .Tags}}
        <div class="mt-3 flex flex-wrap gap-1.5">
          {{range .Tags}}<span class="rounded-full bg-slate-800 px-2 py-0.5 text-xs text-slate-300">{{.}}</span>{{end}}
        </div>
        {{end}}
        <div class="mt-auto pt-4 text-xs text-slate-500">
          {{if .LatestVer}}latest {{.LatestVer}}{{end}}
        </div>
      </article>
      {{end}}
    </section>
    {{else}}
    <p class="text-slate-400">No assets found{{if .Query}} for “{{.Query}}”{{end}}.</p>
    {{end}}
  </main>
</body>
</html>
{{end}}