{{define "index"}}<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AgentHub</title>
  <link rel="stylesheet" href="/static/app.css">
  <script type="module">
    // Shadow SSO SDK initialization
    import {
      generatePkcePair,
      isSilentLoginError,
      silentLogin,
      mountOneTap,
      silentLogin as silentLoginSDK,
    } from 'https://cdn.jsdelivr.net/npm/@pilab/shadow-sso@1.0.0/+esm';

    // Check for existing SSO session silently
    async function checkSilentLogin() {
      const pkce = await generatePkcePair();
      sessionStorage.setItem('sso_pkce_verifier', pkce.verifier);

      try {
        const { code, state } = await silentLoginSDK({
          issuer: 'https://sso.pilab.hu',
          clientId: 'agenthub-web',
          redirectUri: '/auth/callback',
          scope: 'openid profile email',
          codeChallenge: pkce.challenge,
          codeChallengeMethod: 'S256',
          timeoutMs: 5000,
        });

        // Exchange code at POST /auth/token (handled by BFF)
        if (code) {
          // Store code_verifier for backend token exchange
          sessionStorage.setItem('sso_code_verifier', pkce.verifier);
          showNotification('SSO session active', 'code_received');
        }
      } catch (error) {
        if (isSilentLoginError(error)) {
          // No active session - show normal login button
          showNotification('No active SSO session', 'silent_login_failed');
        }
      }
    }

    // One-tap corner login
    function mountOneTap() {
      mountOneTap({
        issuer: 'https://sso.pilab.hu',
        clientId: 'agenthub-web',
        redirectUri: '/auth/callback',
        scope: 'openid profile email',
        // optional: autoSelect, desktopOnly
      });
    }

    // Show notification to user
    function showNotification(title, status) {
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 px-4 py-3 rounded-md text-sm ${
        status === 'code_received' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
      }`;
      notification.textContent = `${title}: ${status}`;
      document.body.appendChild(notification);
      setTimeout(() => notification.remove(), 5000);
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
      checkSilentLogin();
      // Uncomment to enable one-tap corner card
      // mountOneTap();
    });
  </script>
</head>
<body class="min-h-full bg-slate-950 text-slate-100 antialiased">
  <main class="mx-auto max-w-5xl px-6 py-16">
    <header class="mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-400">AgentHub</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">The package registry and control plane for AI-agent assets.</h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-300">
        Publish, version, sign, and install agents, skills, tools, prompts and packs —
        immutably and reproducibly. Served by a single Go binary.
      </p>
      <p class="mt-3 text-xs text-slate-500">version {{.Version}}</p>
    </header>

    <!-- SSO Status Panel -->
    <section class="mb-8 rounded-xl border border-slate-800 bg-slate-900/60 p-4">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-sky-400">SSO Authentication</h2>
      <div id="sso-status">
        <p class="text-sm text-slate-400">Checking SSO session...</p>
      </div>
      <button id="login-btn" class="mt-2 rounded bg-sky-600 px-4 py-2 text-sm text-white hover:bg-sky-500 transition">
        Login with SSO
      </button>
      <button id="one-tap-btn" class="mt-2 rounded bg-sky-600 px-4 py-2 text-sm text-white hover:bg-sky-500 transition hidden">
        One-Tap Corner Login
      </button>
    </section>

    <section class="grid gap-4 sm:grid-cols-3">
      <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <h2 class="text-lg font-semibold">Catalog</h2>
        <p class="mt-2 text-sm text-slate-400">Search, browse, resolve and download versioned agent assets.</p>
      </article>
      <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <h2 class="text-lg font-semibold">Publishing</h2>
        <p class="mt-2 text-sm text-slate-400">Validate, sign, publish, deprecate and yank versions.</p>
      </article>
      <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <h2 class="text-lg font-semibold">Consumption</h2>
        <p class="mt-2 text-sm text-slate-400">CLI + OpenCode V2 plugin reconcile desired state into local runtime state.</p>
      </article>
    </section>

    {{if .Assets}}
    <section class="mt-12">
      <div class="mb-4 flex items-end justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-400">Featured assets</h2>
        <a href="/assets" class="text-sm text-sky-400 hover:text-sky-300">Browse all →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {{range .Assets}}
        <article class="flex flex-col rounded-xl border border-slate-800 bg-slate-900/60 p-5">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-xl">
              {{if .IconDigest}}<img src="/icon/{{.IconDigest}}" alt="" class="h-10 w-10 rounded-lg object-cover">{{else}}{{kindIcon .Kind}}{{end}}
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="truncate font-semibold"><a href="/a/{{.Namespace}}/{{kindSlug .Kind}}/{{.Name}}" class="hover:text-sky-300">{{or .DisplayName .Name}}</a></h3>
              <p class="text-xs uppercase tracking-widest text-slate-500">{{kindSlug .Kind}} · {{.Namespace}}</p>
            </div>
          </div>
          {{if .Summary}}<p class="mt-3 text-sm text-slate-300">{{.Summary}}</p>{{end}}
          {{if .Tags}}<div class="mt-3 flex flex-wrap gap-1.5">{{range .Tags}}<span class="rounded-full bg-slate-800 px-2 py-0.5 text-xs text-slate-300">{{.}}</span>{{end}}</div>{{end}}
        </article>
        {{end}}
      </div>
    </section>
    {{end}}
    <section class="mt-12 rounded-xl border border-slate-800 bg-slate-900/40 p-5">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-400">Quick install</h2>
      <pre class="mt-3 overflow-x-auto rounded-lg bg-black/40 p-4 text-sm text-sky-200"><code>go install go.pilab.hu/agenthub/cmd/agenthub@latest
agenthub add pilab/pack/pirat-agents@1.0.0
agenthub install</code></pre>
    </section>
  </main>

  <script type="module">
    // Initialize Shadow SSO on load
    document.addEventListener('DOMContentLoaded', async () => {
      // Check for silent login
      await (async () => {
        const pkce = await generatePkcePair();
        sessionStorage.setItem('sso_pkce_verifier', pkce.verifier);

        try {
          const { code } = await silentLoginSDK({
            issuer: 'https://sso.pilab.hu',
            clientId: 'agenthub-web',
            redirectUri: '/auth/callback',
            scope: 'openid profile email',
            codeChallenge: pkce.challenge,
            codeChallengeMethod: 'S256',
            timeoutMs: 5000,
          });
          if (code) {
            // Redirect or show success
            document.getElementById('sso-status').innerHTML = '<p class="text-green-400">SSO session active - code received</p>';
          }
        } catch (error) {
          if (window.isSilentLoginError(error)) {
            document.getElementById('sso-status').innerHTML = '<p class="text-red-400">No active SSO session</p>';
          }
        }
      })();

      // One-tap corner card
      const oneTapBtn = document.getElementById('one-tap-btn');
      if (oneTapBtn) {
        // mountOneTap({...}); // enabled when needed
        oneTapBtn.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
{{end}}
